# Supabase: self-hosted (Coolify, Hostinger VPS in Malaysia) — data residency
# requirement, patient data must stay in Malaysia. Not Supabase cloud.
# Get these from your Coolify Supabase service's Kong/API env vars.

VITE_SUPABASE_URL="http://<your-kong-host>"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-anon-public-key>"

# Local dose-suggestion sidecar (knowledge-service). Offline, Ollama-backed.
# See knowledge-service/README.md to set it up. Leave VITE_KNOWLEDGE_ENABLED
# unset/"false" until the sidecar is running.
VITE_KNOWLEDGE_ENABLED="false"
VITE_KNOWLEDGE_URL="http://localhost:8787"
VITE_KNOWLEDGE_KEY=""

# Pre-Talk Survey (/survey) — Google Apps Script Web App URL that appends
# rows to the survey's Google Sheet. See docs/survey-apps-script.md for setup.
VITE_SHEETS_ENDPOINT=""

# AI assistant (chat widget, antibiotic-suggest, pathway-check) — backed by a
# self-hosted Ollama container on the same VPS, zero recurring cost, patient
# data never leaves the box. ANTHROPIC_API_KEY / UPSTASH_* are gone; nothing
# in this app calls a paid API anymore.
VITE_AI_ENABLED="false"
VITE_PATHWAY_CHECK_ENABLED="true"
VITE_AI_STREAMING="true"
VITE_AI_TIMEOUT_MS="90000"

# The following are edge-function secrets, not frontend build vars — set
# them in Coolify on the supabase-edge-functions service, never in this
# file: OLLAMA_URL, OLLAMA_MODEL, OLLAMA_NUM_CTX, OLLAMA_TIMEOUT_MS,
# APP_ORIGIN, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY. The Ollama
# container itself must never be reachable from outside the Coolify network
# — only edge functions talk to it, on http://ollama:11434.
