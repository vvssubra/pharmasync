# Path to your Obsidian vault folder (or a subfolder of it containing dosing notes).
VAULT_PATH=C:/Users/you/Documents/ObsidianVault/Dosing

# Local Ollama server (default install listens here).
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Sidecar HTTP server.
PORT=8787

# Optional shared secret the frontend must send as `x-knowledge-key`.
# Leave blank to disable (fine for a trusted office LAN).
KNOWLEDGE_KEY=

# Comma-separated list of origins allowed to call this service (CORS).
ALLOWED_ORIGIN=http://localhost:8080

# Minimum cosine similarity (0-1) for a note to be considered a match.
MATCH_THRESHOLD=0.5

# Max number of matches returned per query.
MAX_MATCHES=3
